
-- Creator Panel V2
-- LocalScript in StarterPlayer > StarterPlayerScripts

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Creator Panel V2",
    LoadingTitle = "Creator Studio",
    LoadingSubtitle = "Build • Record • Save",
    ConfigurationSaving = {
        Enabled = false
    }
})

local Main = Window:CreateTab("Creator", 4483362458)

Main:CreateSection("Building")

Main:CreateButton({
    Name = "F3X Build Tool",
    Callback = function()
        local player = Players.LocalPlayer
        local backpack = player:WaitForChild("Backpack")

        -- F3X muss als Tool in deinem Spiel vorhanden sein.
        local tool = backpack:FindFirstChild("Building Tools")
            or (player.Character and
                player.Character:FindFirstChild("Building Tools"))

        if tool and tool:IsA("Tool") then
            tool.Parent = backpack
            player.Character:WaitForChild("Humanoid"):EquipTool(tool)
        else
            Rayfield:Notify({
                Title = "F3X",
                Content = "F3X ist nicht installiert. Integriere ein autorisiertes Bautool in dein Spiel.",
                Duration = 5
            })
        end
    end
})

Main:CreateSection("Screen Recording")

Main:CreateButton({
    Name = "Aufnahme AN",
    Callback = function()
        Rayfield:Notify({
            Title = "Aufnahme starten",
            Content = "Drücke Windows + Alt + R, um die Aufnahme zu starten.",
            Duration = 5
        })
    end
})

Main:CreateButton({
    Name = "Aufnahme AUS",
    Callback = function()
        Rayfield:Notify({
            Title = "Aufnahme stoppen",
            Content = "Drücke Windows + Alt + R, um die Aufnahme zu beenden.",
            Duration = 5
        })
    end
})

Main:CreateButton({
    Name = "Video-Speicher",
    Callback = function()
        Rayfield:Notify({
            Title = "Gespeicherte Videos",
            Content = "Öffne Windows Explorer > Videos > Captures.",
            Duration = 6
        })
    end
})

Rayfield:Notify({
    Title = "Creator Panel",
    Content = "Panel geladen!",
    Duration = 4
})
