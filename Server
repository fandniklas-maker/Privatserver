
-- Content Creator Panel
-- LocalScript in StarterPlayerScripts

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Creator Studio | Panel",
    LoadingTitle = "Content Creator",
    LoadingSubtitle = "Build • Record • Create",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "CreatorStudio",
        FileName = "Settings"
    }
})

-- BUILD TAB
local BuildTab = Window:CreateTab("Build", 4483362458)

BuildTab:CreateSection("F3X Building Tools")

BuildTab:CreateButton({
    Name = "F3X öffnen",
    Callback = function()
        -- F3X muss in deinem Spiel installiert sein.
        -- Das Script öffnet es nur, wenn dein Spiel
        -- dafür eine eigene Integration bereitstellt.

        local event = game:GetService("ReplicatedStorage")
            :FindFirstChild("OpenF3X")

        if event and event:IsA("BindableEvent") then
            event:Fire()
        else
            Rayfield:Notify({
                Title = "F3X",
                Content = "Bitte F3X in Roblox Studio integrieren.",
                Duration = 5
            })
        end
    end
})

BuildTab:CreateSection("Studio")

BuildTab:CreateButton({
    Name = "Bau-Hinweis",
    Callback = function()
        Rayfield:Notify({
            Title = "Creator Tip",
            Content = "Nutze F3X oder die Studio-Bautools.",
            Duration = 4
        })
    end
})

-- RECORD TAB
local RecordTab = Window:CreateTab("Recording", 4483362458)

RecordTab:CreateSection("Windows Bildschirmaufnahme")

RecordTab:CreateButton({
    Name = "Aufnahme starten",
    Callback = function()
        Rayfield:Notify({
            Title = "Aufnahme starten",
            Content = "Drücke WIN + ALT + R.",
            Duration = 5
        })
    end
})

RecordTab:CreateButton({
    Name = "Aufnahme stoppen",
    Callback = function()
        Rayfield:Notify({
            Title = "Aufnahme stoppen",
            Content = "Drücke erneut WIN + ALT + R.",
            Duration = 5
        })
    end
})

RecordTab:CreateSection("Video speichern")

RecordTab:CreateButton({
    Name = "Speicherort anzeigen",
    Callback = function()
        Rayfield:Notify({
            Title = "Deine Videos",
            Content = "Windows: Videos > Captures",
            Duration = 6
        })
    end
})

RecordTab:CreateButton({
    Name = "Aufnahme-Hilfe",
    Callback = function()
        Rayfield:Notify({
            Title = "Windows Game Bar",
            Content = "WIN + G öffnet die Aufnahme-Steuerung.",
            Duration = 5
        })
    end
})

-- INFO TAB
local InfoTab = Window:CreateTab("Creator Info", 4483362458)

InfoTab:CreateSection("Dein Dashboard")

InfoTab:CreateLabel("Creator: " .. player.DisplayName)
InfoTab:CreateLabel("Build: F3X Integration erforderlich")
InfoTab:CreateLabel("Recording: Windows Game Bar")

Rayfield:Notify({
    Title = "Creator Studio",
    Content = "Dein Panel ist bereit!",
    Duration = 5
})
