
local Rayfield = loadstring(game:HttpGet(
    "https://sirius.menu/rayfield"
))()

local Window = Rayfield:CreateWindow({
    Name = "Creator Panel | V1",
    LoadingTitle = "Content Creator",
    LoadingSubtitle = "Creator Dashboard",
    Theme = "Default",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "CreatorPanel",
        FileName = "Settings"
    }
})

-- Dashboard
local Dashboard = Window:CreateTab("Dashboard", 4483362458)

Dashboard:CreateSection("Creator Status")

Dashboard:CreateLabel("Content Creator Panel aktiviert")

Dashboard:CreateButton({
    Name = "Creator Info anzeigen",
    Callback = function()
        Rayfield:Notify({
            Title = "Creator Panel",
            Content = "Willkommen im Creator Dashboard!",
            Duration = 4
        })
    end
})

-- Video Tools
local Video = Window:CreateTab("Video Tools", _cameraIcon or 4483362458)

Video:CreateSection("Aufnahme")

Video:CreateToggle({
    Name = "Aufnahme-Hinweis",
    CurrentValue = false,
    Flag = "RecordingHint",
    Callback = function(Value)
        Rayfield:Notify({
            Title = "Video Tools",
            Content = Value and "Aufnahme aktiviert" or "Aufnahme deaktiviert",
            Duration = 3
        })
    end
})

Video:CreateButton({
    Name = "Video-Marker setzen",
    Callback = function()
        Rayfield:Notify({
            Title = "Video Marker",
            Content = "Marker gesetzt!",
            Duration = 3
        })
    end
})

-- Creator Settings
local Settings = Window:CreateTab("Settings", 4483362458)

Settings:CreateSection("Einstellungen")

Settings:CreateSlider({
    Name = "UI Transparenz",
    Range = {0, 100},
    Increment = 5,
    Suffix = "%",
    CurrentValue = 0,
    Flag = "UITransparency",
    Callback = function(Value)
        print("Transparenz:", Value)
    end
})

Settings:CreateButton({
    Name = "Creator Panel schließen",
    Callback = function()
        Rayfield:Destroy()
    end
})

Rayfield:Notify({
    Title = "Creator Panel",
    Content = "Panel erfolgreich geladen!",
    Duration = 5
})
